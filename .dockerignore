# Keep the build context small. Anything that ends up in the image is copied
# explicitly by the Dockerfile; everything else is excluded here.

# VCS / metadata
.git
.gitignore
.gitattributes
.github

# Local artifacts
node_modules
dist
dist-server
build
coverage
.cache
.parcel-cache

# Local-only caches and codegraph artifacts
.codegraph/cache
.codegraph/index
.codegraph/logs
.codegraph/codegraph.db

# Editor / OS noise
.vscode
.idea
.DS_Store
*.swp
*.swo

# Logs and env
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.*
!.env.example

# Docker files (no need to send them to the daemon inside themselves)
Dockerfile
Dockerfile.*
docker-compose.yml
docker-compose.*.yml
.dockerignore
